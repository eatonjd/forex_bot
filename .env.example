# Environment variables for Forex Bot
# Copy this file to .env and fill in your actual values

# Google Gemini API (Phase 2.2 - AI Analysis)
GOOGLE_API_KEY=your_gemini_api_key_here

# Telegram Bot Notifications (Recommended)
# Create bot via @BotFather, get chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Trading APIs (if using live trading)
# ALPACA_API_KEY=your_alpaca_key_here
# ALPACA_SECRET_KEY=your_alpaca_secret_here

# SMS Notifications (via Gmail SMTP)
# Generate App Password at: https://myaccount.google.com/apppasswords
SMS_PHONE_NUMBER=your_phone_number
SMTP_USER=your_gmail_address
SMTP_PASSWORD=your_gmail_app_password
